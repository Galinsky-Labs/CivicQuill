{
  "name": "@quill/civicquill",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs registry/pr-contract.test.mjs",
    "check": "node scripts/validate-pr-registry.mjs && node scripts/validate-security.mjs && npm test",
    "build": "node scripts/build.mjs",
    "migrate": "node scripts/migrate.mjs",
    "start": "node server/start.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/*.browser.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./extension": "./server/civic-extension.mjs"
  },
  "description": "CivicQuill: legislative collaboration on the Distributed Governance Engine",
  "dependencies": {
    "@distributed-governance/engine": "https://codeload.github.com/Galinsky-Labs/Distributed-Governance-Engine/tar.gz/da256937e436e77eed954daf8d5e3fef553ec983"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.14.0"
  }
}
